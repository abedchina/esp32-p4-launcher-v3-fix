#3bc9f5;text-decoration:none}li{display:flex;gap:12px;padding:10px 0;border-bottom:1px solid #24406e}li a:first-child{flex:1;word-break:break-all}ul{list-style:none;padding:0}button,input{font:inherit;padding:6px 10px}small{color:#8fa3bf}</style></head><body><main><h1>P4 Launcher files</h1><p id=path></p><p><input type=file id=f multiple> <button onclick=up()>Upload</button> <button onclick=md()>New folder</button></p><p id=st></p><ul id=l></ul></main><script>let pin=prompt('PIN shown on the Wi-Fi screen')||'',cwd='/sd';const q=(a,p)=>'/api/'+a+'?pin='+pin+'&path='+encodeURIComponent(p);const st=t=>document.getElementById('st').textContent=t;async function ls(p){const r=await fetch(q('ls',p));if(!r.ok){st('Error: '+await r.text());return}cwd=p;document.getElementById('path').textContent=p;const u=document.getElementById('l');u.textContent='';if(p!='/sd')add('..',1,0,p.slice(0,p.lastIndexOf('/')));for(const e of await r.json())add(e.n,e.d,e.s,p+'/'+e.n)}function add(n,d,s,p){const li=document.createElement('li'),a=document.createElement('a');a.textContent=d?n+'/':n;a.href=d?'#':q('get',p);if(d)a.onclick=()=>{ls(p);return false};else a.download=n;li.append(a);if(n!='..'){if(!d){const m=document.createElement('small');m.textContent=(s/1048576).toFixed(2)+' MB';li.append(m)}const b=document.createElement('button');b.textContent='Delete';b.onclick=()=>rm(p,n);li.append(b)}document.getElementById('l').append(li)}async function rm(p,n){if(!confirm('Delete '+n+'?'))return;const r=await fetch(q('rm',p),{method:'POST'});st(r.ok?'Deleted':'Error: '+await r.text());ls(cwd)}async function md(){const n=prompt('Folder name');if(!n)return;const r=await fetch(q('mkdir',cwd+'/'+n),{method:'POST'});st(r.ok?'Created':'Error: '+await r.text());ls(cwd)}async function up(){for(const f of document.getElementById('f').files){st('Uploading '+f.name+'...');const r=await fetch(q('put',cwd+'/'+f.name),{method:'PUT',body:f});if(!r.ok){st('Error: '+await r.text());return}}st('Done');ls(cwd)}ls(cwd)</script></body></html>␀␀␀␀␀␀␀␀ÿÿÿ␀␀␀␀␀␀␀␀P␀␀€␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀f@î&@#@␀␀␀␀0Õ@‚␀␀␀‚␀␀␀Ê␀␀␀␀à␀␀à␀␀à␀␀à€™@¶—@␀␀␀␀␀␀␀␀␀␀␀ÿ␀(½@␀␀␀␀␀␀␀␀ØÏ@èÊ@<Ê@<½@␀(L½@œÉ@üÈ@=1␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀
